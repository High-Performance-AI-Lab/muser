+static bool muser_is_lower_hex(const char * value, size_t size) {
+    if (std::strlen(value) != size) {
+        return false;
+    }
+    for (size_t i = 0; i < size; ++i) {
+        const char ch = value[i];
+        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) {
+            return false;
+        }
+    }
+    return true;
