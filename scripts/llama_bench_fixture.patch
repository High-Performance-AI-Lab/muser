+struct muser_exact_candidate {
+    int   id    = -1;
+    float logit = -std::numeric_limits<float>::infinity();
+};
+
+static bool muser_better_candidate(float logit, int token_id, float best_logit, int best_id) {
+    return best_id < 0 || logit > best_logit || (logit == best_logit && token_id < best_id);
+}
+
+static bool muser_find_exact_top10(
+        int n_vocab,
+        const float * logits,
+        std::array<muser_exact_candidate, 10> & result,
+        std::string & error) {
+    for (int token_id = 0; token_id < n_vocab; ++token_id) {
+        const float logit = logits[token_id];
+        if (!std::isfinite(logit)) {
+            error = "non-finite pre-quantization llama logit at token " + std::to_string(token_id);
+            return false;
+        }
+        for (size_t rank = 0; rank < result.size(); ++rank) {
+            if (!muser_better_candidate(logit, token_id, result[rank].logit, result[rank].id)) {
+                continue;
+            }
+            for (size_t shift = result.size() - 1; shift > rank; --shift) {
+                result[shift] = result[shift - 1];
+            }
+            result[rank] = {token_id, logit};
+            break;
+        }
+    }
+    if (result.back().id < 0) {
+        error = "could not identify ten distinct pre-quantization llama candidates";
+        return false;
+    }
+    return true;
+}
+
+static bool muser_write_exact_top10_rows(
+        std::ostream & out,
+        int n_vocab,
+        const float * logits,
+        const int * tokens,
+        int n_token,
+        const std::vector<uint16_t> & log_probs,
+        const std::vector<double> & target_nlls,
+        int chunk,
+        int first_position,
+        std::string & error) {
+    const int nv = 2*((n_vocab + 1)/2) + 4;
+    for (int row = 0; row < n_token; ++row) {
+        std::array<muser_exact_candidate, 10> top10;
+        if (!muser_find_exact_top10(n_vocab, logits + size_t(row)*n_vocab, top10, error)) {
+            error += " (chunk " + std::to_string(chunk) + ", position " +
+                     std::to_string(first_position + row) + ")";
+            return false;
+        }
+        const double target_nll = target_nlls.at(size_t(row));
+        if (!std::isfinite(target_nll) || target_nll < 0.0) {
+            error = "invalid exact target NLL (chunk " + std::to_string(chunk) +
+                    ", position " + std::to_string(first_position + row) + ")";
+            return false;
+        }
+
+        const uint16_t * encoded = log_probs.data() + size_t(row)*nv;
+        float scale = 0.0f;
+        float minimum_log_probability = 0.0f;
+        std::memcpy(&scale, encoded, sizeof(scale));
+        std::memcpy(&minimum_log_probability, encoded + 2, sizeof(minimum_log_probability));
+        const uint16_t * quantized = encoded + 4;
+
+        out << "{\"chunk\":" << chunk
+            << ",\"position\":" << first_position + row
+            << ",\"input_token_id\":" << tokens[row]
+            << ",\"target_token_id\":" << tokens[row + 1]
+            << ",\"target_nll\":" << target_nll
+            << ",\"row_scale\":" << scale
+            << ",\"minimum_log_probability\":" << minimum_log_probability
+            << ",\"candidates\":[";
+        for (size_t rank = 0; rank < top10.size(); ++rank) {
+            if (rank != 0) {
+                out << ',';
+            }
+            out << "{\"token_id\":" << top10[rank].id
+                << ",\"logit\":" << top10[rank].logit
+                << ",\"quantized_u16\":" << quantized[top10[rank].id] << '}';
+        }
+        out << "]}\n";
+        if (!out) {
+            error = "failed while writing exact top-10 sidecar";
+            return false;
+        }
+    }
+    return true;
+}
