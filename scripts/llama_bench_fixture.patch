+static bool validate_fixture_shape(
+        const cmd_params & params,
+        const std::vector<cmd_params_instance> & instances,
+        std::string & error) {
+    const bool fixture_mode = params.prompt_fixture.supplied() || params.decode_fixture.supplied();
+    if (!fixture_mode) {
+        return true;
+    }
+    if (!is_lower_hex(MUSER_BUILD_UPSTREAM_COMMIT, 40)) {
+        error = "fixture mode requires a build sealed to an exact lowercase upstream commit";
+        return false;
+    }
+    if (!is_lower_hex(MUSER_BUILD_PATCH_SHA256, 64)) {
+        error = "fixture mode requires a build sealed with a lowercase 64-character patch SHA-256";
+        return false;
+    }
+    if (instances.size() != 1) {
+        error = "fixture mode requires exactly one benchmark cell per llama-bench process";
+        return false;
+    }
+    if (params.no_warmup) {
+        error = "fixture mode requires the canonical warmup policy; --no-warmup is forbidden";
+        return false;
+    }
+    if (params.reps != 5) {
+        error = "fixture mode requires exactly 5 repetitions";
+        return false;
+    }
+
+    const cmd_params_instance & inst = instances.front();
+    if (inst.n_prompt > 0 && inst.n_depth > 0) {
+        error = "fixture mode cannot combine n_prompt and n_depth in one cell";
+        return false;
+    }
+    if (inst.n_prompt > 0 && inst.n_gen > 0) {
+        error = "fixture mode requires separate prompt and decode benchmark cells";
+        return false;
+    }
+    if (inst.n_depth < 0) {
+        error = "fixture mode does not allow a negative target depth";
+        return false;
+    }
+    const int expected_prompt = inst.n_depth > 0 ? inst.n_depth : inst.n_prompt;
+    if ((expected_prompt > 0) != params.prompt_fixture.supplied()) {
+        error = expected_prompt > 0
+            ? "fixture mode requires a prompt fixture for every prompt/depth token"
+            : "prompt fixture was supplied but this cell has no prompt/depth tokens";
+        return false;
+    }
+    if ((inst.n_gen > 0) != params.decode_fixture.supplied()) {
+        error = inst.n_gen > 0
+            ? "fixture mode requires a decode fixture for every teacher-forced decode token"
+            : "decode fixture was supplied but this cell has no decode tokens";
+        return false;
+    }
+    if (params.prompt_fixture.supplied() && params.prompt_fixture.tokens.size() != size_t(expected_prompt)) {
+        error = "prompt fixture length " + std::to_string(params.prompt_fixture.tokens.size()) +
+                " does not equal active prompt/depth length " + std::to_string(expected_prompt);
+        return false;
+    }
+    if (params.decode_fixture.supplied() && params.decode_fixture.tokens.size() != size_t(inst.n_gen)) {
+        error = "decode fixture length " + std::to_string(params.decode_fixture.tokens.size()) +
+                " does not equal active generation length " + std::to_string(inst.n_gen);
+        return false;
+    }
+    return true;
+}
