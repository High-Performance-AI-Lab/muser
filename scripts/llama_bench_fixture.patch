+static token_fixture load_token_fixture(const std::string & path) {
+    token_fixture fixture;
+    fixture.path = path;
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+        throw std::runtime_error("cannot open token fixture: " + path);
+    }
+
+    comparator_sha256 file_hasher;
+    std::array<char, 64 * 1024> buffer{};
+    uint64_t value = 0;
+    bool have_digits = false;
+    bool comma_pending = false;
+    bool have_token = false;
+
+    const auto finish_token = [&]() {
+        if (!have_digits) {
+            return;
+        }
+        fixture.tokens.push_back(llama_token(value));
+        value = 0;
+        have_digits = false;
+        have_token = true;
+    };
+
+    while (input) {
+        input.read(buffer.data(), buffer.size());
+        const std::streamsize count = input.gcount();
+        if (count <= 0) {
+            continue;
+        }
+        file_hasher.update(reinterpret_cast<const uint8_t *>(buffer.data()), size_t(count));
+        for (std::streamsize i = 0; i < count; ++i) {
+            const unsigned char ch = static_cast<unsigned char>(buffer[size_t(i)]);
+            if (ch >= '0' && ch <= '9') {
+                if (!have_digits) {
+                    comma_pending = false;
+                }
+                const uint64_t digit = uint64_t(ch - '0');
+                if (value > (uint64_t(std::numeric_limits<int32_t>::max()) - digit) / 10) {
+                    throw std::runtime_error("token id exceeds INT32_MAX in fixture: " + path);
+                }
+                value = value * 10 + digit;
+                have_digits = true;
+            } else if (ch == ',') {
+                if (have_digits) {
+                    finish_token();
+                } else if (!have_token || comma_pending) {
+                    throw std::runtime_error("empty token before comma in fixture: " + path);
+                }
+                comma_pending = true;
+            } else if (ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' || ch == '\f' || ch == '\v') {
+                finish_token();
+            } else {
+                throw std::runtime_error("invalid byte in token fixture: " + path);
+            }
+        }
+    }
+    if (input.bad()) {
+        throw std::runtime_error("failed while reading token fixture: " + path);
+    }
+    finish_token();
+    if (comma_pending) {
+        throw std::runtime_error("trailing comma in token fixture: " + path);
+    }
+    if (fixture.tokens.empty()) {
+        throw std::runtime_error("token fixture is empty: " + path);
+    }
+    fixture.file_sha256 = file_hasher.hex_digest();
+    fixture.tokens_sha256 = token_vector_sha256(fixture.tokens);
+    return fixture;
+}
