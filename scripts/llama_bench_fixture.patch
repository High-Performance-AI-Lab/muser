+static bool validate_fixture_vocab(
+        const cmd_params & params,
+        const llama_model * model,
+        std::string & error) {
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    if (n_vocab <= 0) {
+        error = "loaded model reports an invalid vocabulary size";
+        return false;
+    }
+    const auto validate_one = [&](const char * name, const token_fixture & fixture) {
+        for (size_t i = 0; i < fixture.tokens.size(); ++i) {
+            if (fixture.tokens[i] < 0 || fixture.tokens[i] >= n_vocab) {
+                error = std::string(name) + " fixture token at index " + std::to_string(i) +
+                        " is outside [0, " + std::to_string(n_vocab) + "): " +
+                        std::to_string(fixture.tokens[i]);
+                return false;
+            }
+        }
+        return true;
+    };
+    return validate_one("prompt", params.prompt_fixture) && validate_one("decode", params.decode_fixture);
+}
