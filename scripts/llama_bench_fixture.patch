+static bool muser_load_exact_token_fixture(
+        const char * path,
+        int32_t n_ctx,
+        int32_t n_vocab,
+        std::vector<llama_token> & tokens,
+        std::string & error) {
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+        error = std::string("cannot open exact token fixture: ") + path;
+        return false;
+    }
+    const std::string bytes(
+        (std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+    if (input.bad() || bytes.empty() || bytes.back() != '\n') {
+        error = "exact token fixture must be a nonempty newline-terminated file";
+        return false;
+    }
+    uint64_t value = 0;
+    bool have_digit = false;
+    for (char byte : bytes) {
+        if (byte >= '0' && byte <= '9') {
+            have_digit = true;
+            value = value * 10 + uint64_t(byte - '0');
+            if (value >= uint64_t(n_vocab)) {
+                error = "exact token fixture contains an out-of-vocabulary token";
+                return false;
+            }
+        } else if (byte == '\n' && have_digit) {
+            tokens.push_back(llama_token(value));
+            value = 0;
+            have_digit = false;
+        } else {
+            error = "exact token fixture must contain one unsigned decimal token per line";
+            return false;
+        }
+    }
+    if (tokens.size() != size_t(n_ctx)) {
+        error = "exact token fixture length differs from the requested context";
+        return false;
+    }
+    // Upstream perplexity deliberately requires two contexts even when the
+    // caller requests one chunk. Duplicate the exact fixture only to satisfy
+    // that preflight; --chunks 1 evaluates and writes the first copy.
+    const std::vector<llama_token> duplicate = tokens;
+    tokens.insert(tokens.end(), duplicate.begin(), duplicate.end());
+    return true;
+}
