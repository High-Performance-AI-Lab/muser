+struct token_fixture {
+    std::string path;
+    std::vector<llama_token> tokens;
+    std::string file_sha256;
+    std::string tokens_sha256;
+
+    bool supplied() const {
+        return !path.empty();
+    }
+};
+
+static std::string token_vector_sha256(const std::vector<llama_token> & tokens) {
+    comparator_sha256 hasher;
+    for (llama_token token : tokens) {
+        sha256_update_u32_le(hasher, uint32_t(token));
+    }
+    return hasher.hex_digest();
+}
+
+static void append_fixture_workload(comparator_sha256 & hasher, const token_fixture & fixture) {
+    sha256_update_u64_le(hasher, fixture.tokens.size());
+    for (llama_token token : fixture.tokens) {
+        sha256_update_u32_le(hasher, uint32_t(token));
+    }
+}
+
+static std::string workload_sha256(const token_fixture & prompt, const token_fixture & decode) {
+    static const char domain[] = "muser-bench-workload-v1\0";
+    comparator_sha256 hasher;
+    hasher.update(domain, sizeof(domain) - 1);
+    append_fixture_workload(hasher, prompt);
+    append_fixture_workload(hasher, decode);
+    return hasher.hex_digest();
+}
