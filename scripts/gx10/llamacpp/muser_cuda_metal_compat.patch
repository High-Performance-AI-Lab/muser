+static __global__ void muser_rms_norm_cpu_order_f32(
+        const float * x, float * y, const int ncols, const int nrows,
+        const size_t s01, const size_t d01, const float eps) {
+    const int row = blockIdx.x;
+    if (row >= nrows) return;
+    const float * xr = x + (size_t) row * s01;
+    float * yr = y + (size_t) row * d01;
+    double sum = 0.0;
+    for (int i = 0; i < ncols; ++i) {
+        sum = muser_dadd_rn(sum, (double) muser_mul_rn(xr[i], xr[i]));
+    }
+    const float mean = (float) muser_ddiv_rn(sum, (double) ncols);
+    const float scale = muser_div_rn(1.0f, muser_sqrt_rn(muser_add_rn(mean, eps)));
+    for (int i = 0; i < ncols; ++i) {
+        yr[i] = muser_mul_rn(xr[i], scale);
+    }
+}
+
+// Cross-vendor normalization follows the Metal SIMD-group topology exactly:
+// 32 lanes accumulate strided elements, then a fixed 16/8/4/2/1 shuffle
+// tree. Most split RMS/MUL boundaries materialize through F16 at both graph
+// nodes; the layer-0 learned norm instead uses the fused companion below.
+static __global__ void muser_rms_norm_cross_vendor_f32(
+        const float * x, float * y, const int ncols, const int nrows,
+        const size_t s01, const size_t d01, const float eps) {
+    const int row = blockIdx.x;
+    const int lane = threadIdx.x;
+    if (row >= nrows) return;
+    const float * xr = x + (size_t) row * s01;
+    float * yr = y + (size_t) row * d01;
+    float sum = 0.0f;
+    for (int i = lane; i < ncols; i += 32) {
+        sum = muser_fma_rn(xr[i], xr[i], sum);
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        const float other = __shfl_down_sync(0xffffffff, sum, offset);
+        if (lane < offset) sum = muser_add_rn(sum, other);
+    }
+    float scale = lane == 0
+        ? muser_div_rn(1.0f, muser_sqrt_rn(muser_fma_rn(
+            sum, muser_div_rn(1.0f, (float) ncols), eps)))
+        : 0.0f;
+    scale = __shfl_sync(0xffffffff, scale, 0);
+    for (int i = lane; i < ncols; i += 32) {
+        const float normalized = muser_fma_rn(xr[i], scale, 0.0f);
+        yr[i] = __half2float(__float2half_rn(normalized));
+    }
+}
+
+// Muse's layer-0 learned attention norm is one fused Metal dispatch. Unlike
+// the later split RMS/MUL boundaries, it rounds only after applying the
+// learned weight. llama.cpp represents the same expression as two graph
+// nodes, so the MUL hook recomputes this one named boundary from the RMS
+// node's original input and preserves Metal's single F16 materialization.
+static __global__ void muser_rms_norm_cross_vendor_weighted_f32(
+        const float * x, const float * weight, float * y,
+        const int ncols, const int nrows, const size_t s01,
+        const size_t d01, const float eps) {
+    const int row = blockIdx.x;
+    const int lane = threadIdx.x;
+    if (row >= nrows) return;
+    const float * xr = x + (size_t) row * s01;
+    float * yr = y + (size_t) row * d01;
+    float sum = 0.0f;
+    for (int i = lane; i < ncols; i += 32) {
+        sum = muser_fma_rn(xr[i], xr[i], sum);
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        const float other = __shfl_down_sync(0xffffffff, sum, offset);
+        if (lane < offset) sum = muser_add_rn(sum, other);
+    }
+    float scale = lane == 0
+        ? muser_div_rn(1.0f, muser_sqrt_rn(muser_fma_rn(
+            sum, muser_div_rn(1.0f, (float) ncols), eps)))
+        : 0.0f;
+    scale = __shfl_sync(0xffffffff, scale, 0);
+    for (int i = lane; i < ncols; i += 32) {
+        const float normalized = muser_fma_rn(xr[i], scale, 0.0f);
+        const float weighted = muser_fma_rn(normalized, weight[i], 0.0f);
+        yr[i] = __half2float(__float2half_rn(weighted));
+    }
+}
