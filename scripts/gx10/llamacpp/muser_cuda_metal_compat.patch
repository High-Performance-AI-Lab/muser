+static bool muser_cuda_try_cpu_order_op(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (!getenv("MUSER_CUDA_CPU_ORDER_ATTN")) return false;
+    switch (dst->op) {
+        case GGML_OP_SOFT_MAX:
+            return muser_cuda_try_cpu_order_softmax(ctx, dst);
+        case GGML_OP_FLASH_ATTN_EXT:
+            return muser_cuda_try_cpu_order_flash(ctx, dst);
+        case GGML_OP_RMS_NORM:
+            return muser_cuda_try_cpu_order_rms(ctx, dst);
+        case GGML_OP_UNARY:
+            return muser_cuda_try_cpu_order_unary(ctx, dst);
+        case GGML_OP_ADD:
+            return muser_cuda_try_cpu_order_binary(ctx, dst, 0);
+        case GGML_OP_MUL:
+            return muser_cuda_try_cpu_order_binary(ctx, dst, 1);
+        case GGML_OP_SCALE:
+            return muser_cuda_try_cpu_order_scale(ctx, dst);
+        default:
+            return false;
+    }
