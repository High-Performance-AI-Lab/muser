+static __global__ void muser_soft_max_cpu_order_f32(
+        const char * x, const char * mask, const int mask_is_f16, const float * sinks, float * dst,
+        const int ncols, const int nrows, const int ne01, const int ne11, const int ne02,
+        const int ne12, const int ne13,
+        const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t nb11, const size_t nb12, const size_t nb13,
+        const size_t nb1, const size_t nb2, const size_t nb3,
+        const float scale, const float max_bias,
+        const uint32_t n_head_log2, const float m0, const float m1) {
+    const int row = blockIdx.x;
+    if (row >= nrows) return;
+    const int i01 = row % ne01;
+    const int i02 = (row / ne01) % ne02;
+    const int i03 = row / (ne01 * ne02);
+    const int i12 = i02 % ne12;
+    const int i13 = i03 % ne13;
+    const float slope = max_bias > 0.0f
+        ? (i02 < (int) n_head_log2 ? powf(m0, (float) (i02 + 1))
+                                   : powf(m1, (float) (2*(i02 - (int) n_head_log2) + 1)))
+        : 1.0f;
+    const float * xr = (const float *) (x + (size_t) i01 * nb01 + (size_t) i02 * nb02 + (size_t) i03 * nb03);
+    float * yr = (float *) ((char *) dst + (size_t) i01 * nb1 + (size_t) i02 * nb2 + (size_t) i03 * nb3);
+    const char * mask_row = mask
+        ? mask + (size_t) (i01 % ne11) * nb11 + (size_t) i12 * nb12 + (size_t) i13 * nb13
+        : nullptr;
+    float maxv = -INFINITY;
+    for (int i = 0; i < ncols; ++i) {
+        float v = xr[i] * scale;
+        if (mask_row) {
+            const float mv = mask_is_f16
+                ? muser_f16_to_f32(*(const uint16_t *) (mask_row + (size_t) i * sizeof(uint16_t)))
+                : *(const float *) (mask_row + (size_t) i * sizeof(float));
+            v += slope * mv;
+        }
+        yr[i] = v;
+        maxv = v > maxv ? v : maxv;
+    }
+    if (sinks) {
+        maxv = sinks[i02] > maxv ? sinks[i02] : maxv;
+    }
+    double sum = 0.0;
+    int i = 0;
+    for (; i + 3 < ncols; i += 4) {
+        float tmp[4];
+        float shifted[4] = { yr[i]-maxv, yr[i+1]-maxv, yr[i+2]-maxv, yr[i+3]-maxv };
+        muser_neon_expf4(tmp, shifted);
+        yr[i] = tmp[0]; yr[i+1] = tmp[1]; yr[i+2] = tmp[2]; yr[i+3] = tmp[3];
+        sum += (double) muser_vaddvq_f32(tmp[0], tmp[1], tmp[2], tmp[3]);
+    }
+    for (; i < ncols; ++i) {
+        const float val = expf(yr[i] - maxv);
+        yr[i] = val;
+        sum += (double) val;
+    }
+    if (sinks) sum += (double) expf(sinks[i02] - maxv);
+    const float inv = (float) (1.0 / sum);
+    const int np = ncols & ~15;
+    for (i = 0; i < np; i += 16) {
+#pragma unroll
+        for (int j = 0; j < 16; ++j) yr[i + j] *= inv;
+    }
+    for (; i < ncols; ++i) yr[i] *= inv;
+}
