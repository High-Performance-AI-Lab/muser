+bool muser_cuda_try_cpu_order_flash(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (!getenv("MUSER_CUDA_CPU_ORDER_ATTN")) return false;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    if (!q || !k || !v) return false;
+    if (dst->type != GGML_TYPE_F32) return false;
+    const int d = (int) q->ne[0];
+    const int nq = (int) q->ne[1];
+    const int nh = (int) q->ne[2];
+    const int nkv = (int) k->ne[1];
+    const int nhk = (int) k->ne[2];
