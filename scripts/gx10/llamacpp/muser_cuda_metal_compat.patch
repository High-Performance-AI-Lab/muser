+static int32_t muser_fixed_horner(const int32_t * coefficients, int count, uint32_t x) {
+    int32_t accumulator = coefficients[count - 1];
+    for (int index = count - 2; index >= 0; --index) {
+        const int64_t product = (int64_t) accumulator * (int64_t) x;
+        accumulator = coefficients[index] + (int32_t) (product >> 32);
+    }
+    return accumulator;
+}
