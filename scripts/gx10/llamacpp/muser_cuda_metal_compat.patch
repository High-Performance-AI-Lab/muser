+// The CPU cache advances theta iteratively across each row.  CUDA's ordinary
+// kernel recomputes pos*pow(theta_scale, pair), which is mathematically equal
+// but not bit-identical.  This default-off diagnostic preserves CPU ordering.
+static __global__ void muser_rope_norm_cpu_order_f32(
+        const float * x, float * dst,
+        const int ne00, const int ne01, const int ne02,
+        const int s01, const int s02, const int s03,
+        const int s1, const int s2, const int s3,
+        const int n_dims, const int32_t * pos,
+        const float * trig_cache, const int cache_nctx,
+        const int64_t * row_indices, const int set_rows_stride) {
+    const int row = blockIdx.x;
+    const int i3 = row / (ne01*ne02);
+    const int i2 = (row - i3*ne01*ne02) / ne01;
+    const int i1 = row - i3*ne01*ne02 - i2*ne01;
+    const int ix = i1*s01 + i2*s02 + i3*s03;
+    int idst = i1*s1 + i2*s2 + i3*s3;
+    if (set_rows_stride != 0) {
+        idst = i1*s1 + row_indices[i2]*set_rows_stride;
+    }
+    const int position = pos[i2];
+    if (position < 0 || position >= cache_nctx) { __trap(); }
+    const float * cache = trig_cache + position*n_dims;
+    for (int i0 = 0; i0 < n_dims; i0 += 2) {
+        const float cos_theta = cache[i0];
+        const float sin_theta = cache[i0 + 1];
+        const float x0 = __half2float(__float2half_rn(x[ix + i0]));
+        const float x1 = __half2float(__float2half_rn(x[ix + i0 + 1]));
+        // The pinned ARM vector loop emits FMUL for the first term followed
+        // by FMLS/FMLA for the second.  Preserve that asymmetric contraction
+        // and the Metal cache's f16 input/output materialization boundaries.
+        dst[idst + i0] = __half2float(__float2half_rn(
+            __fmaf_rn(-x1, sin_theta, __fmul_rn(x0, cos_theta))));
+        dst[idst + i0 + 1] = __half2float(__float2half_rn(
+            __fmaf_rn(x0, sin_theta, __fmul_rn(x1, cos_theta))));
+    }
